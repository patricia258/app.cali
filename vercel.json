{
  "git": {
    "deploymentEnabled": {
      "codex/cali-consolidacao": false
    }
  },
  "redirects": [
    {
      "source": "/brand/cali-workspace-preview-v2.jpg",
      "destination": "/brand/cali-workspace-preview.jpg",
      "permanent": true
    },
    {
      "source": "/landing/cali-workspace-login-v2.jpg",
      "destination": "/landing/cali-workspace-sign-in-preview.jpg",
      "permanent": true
    },
    {
      "source": "/report-flow-cleanup-v57.css",
      "destination": "/report-client-reading.css",
      "permanent": true
    },
    {
      "source": "/report-print-completeness-v63.css",
      "destination": "/report-print-completeness.css",
      "permanent": true
    },
    {
      "source": "/report-print-ready-v64.js",
      "destination": "/report-print-ready.js",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/f/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|linkedinbot|twitterbot|telegrambot|slackbot|discordbot|skypeuripreview|googlebot|bingbot|applebot|pinterest|embedly|iframely).*"
        }
      ],
      "destination": "/api/form-preview?slug=:slug"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
